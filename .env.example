# AI Agent Bridge: the service's secrets. Copy this to .env next to aab.yaml
# and fill in what you use. The service loads that file at startup, so you do
# not need to source it first, and a real environment variable always wins
# over a line here.
#
# Nothing in this file belongs in aab.yaml. The YAML names the environment
# variable to read; only this file holds the value.

# The Anthropic API key the agent loop answers questions with. Leave it empty
# only if you set the model to "fake", which runs the scripted model and calls
# no API at all.
# OpenRouter, the default provider: one key for every model it lists.
OPENROUTER_API_KEY=
# Only for model.provider: anthropic.
ANTHROPIC_API_KEY=

# The Factorio server's RCON password, from its server settings. This name is
# shared with Open Discord Bridge on purpose: one .env can drive both services
# against the same server.
FACTORIO_RCON_PASSWORD=

# Bearer token for the control API's /v1/status. Leave it empty to leave the
# endpoint open, which is fine while the service binds to localhost.
AAB_CONTROL_TOKEN=

# Only for transport: sftp, when the service runs on other infrastructure than
# Factorio and reads the events file over SFTP with a password rather than a
# key. Also shared with Open Discord Bridge.
SFTP_PASSWORD=
