# AI Agent Bridge: example service config. Copy to aab.yaml and edit.
# Secrets come from env vars, never this file.
#
# This is a TEMPLATE with placeholder values. Do NOT deploy it verbatim as a live
# aab.yaml: its mere presence switches the service into file mode, which ignores every
# AAB_* environment variable. Panels/hosts driving the service via env vars should ship
# NO aab.yaml at all (or set AAB_CONFIG=none to force env-var mode even if a stray file
# appears).

factorio:
  rcon:
    address: 127.0.0.1:27015
    password_env: FACTORIO_RCON_PASSWORD
  # Path to the JSONL the companion mod writes. The service tails it into the history
  # database, which is what "since I last died" questions are answered from. Local path,
  # or the remote path when transport is sftp. Supports ${ENV} and a leading ~/.
  events_file: ${HOME}/factorio/script-output/ai-agent-bridge/events.jsonl

  # Only used when transport is "sftp" (the service on separate infra from Factorio).
  # sftp:
  #   host: game-host:22
  #   user: aab-service
  #   key_path: /secrets/aab_ed25519     # or set a password via password_env
  #   password_env: SFTP_PASSWORD
  #   known_hosts_path: /secrets/known_hosts # omit to skip host-key verification (logs a warning)

transport: local        # local | sftp  (RCON is always the control path either way)
poll_interval: 1s

# Also write the service's own logs to a file (in addition to stdout). Useful when
# stdout isn't visible, e.g. a hosting panel that backgrounds the service. Defaults to
# aab.log next to the events file (local transport). Set to "-" to log to stdout only.
# log_file: ${HOME}/factorio/script-output/ai-agent-bridge/aab.log

# The model. One section for every provider (docs/design/phase3-spec.md part 3).
model:
  # openrouter (default): any model OpenRouter lists that supports tool calling, one
  # key for all of them. anthropic: the Anthropic API directly, with an Anthropic key.
  # fake: the scripted model the end-to-end tests use, no key needed.
  provider: openrouter
  # Ids as OpenRouter writes them. Listed 2026-09-10, USD per million tokens in / out:
  #   deepseek/deepseek-v4-pro-0813    1.05 / 3.15   the everyday model (default)
  #   deepseek/deepseek-v4.1-flash     0.30 / 1.20   the small one
  #   anthropic/claude-opus-5          5.00 / 25.00
  # OpenRouter picks which host serves the model unless told which to prefer, and
  # hosts differ a lot: measured on one server, the same model answered a round in
  # 4 seconds at the median on one host and 13 on another, with a 35-second tail,
  # and the prompt cache is per host, so every switch is a cold round. The log's
  # "via=" and `aab stats` name the hosts seen; list the good ones here, in order.
  # providers: [StreamLake]
  # allow_fallbacks: false   # true lets OpenRouter use any other host when these fail
  # Check the live list at https://openrouter.ai/api/v1/models and keep to ids whose
  # supported_parameters include "tools". For provider anthropic use the Anthropic id,
  # claude-sonnet-5 for instance.
  id: deepseek/deepseek-v4-pro-0813
  # Reserved for sub-agents on a cheaper model (PLAN.md "Later"); unused until then.
  small: deepseek/deepseek-v4.1-flash
  # OpenRouter tries these in order when the model above fails.
  fallbacks: []
  # Models reason before they answer unless told not to, and on a question like "what
  # forces are there" that reasoning is most of the output bill. off sends reasoning
  # disabled; model leaves it to the model's default; low, medium or high ask for that
  # much of it.
  # low is the default: with reasoning off a model got the arithmetic of a comparison
  # right and the verdict wrong; a little reasoning fixes that for a few hundred cheap
  # tokens a question, and the log's reasoning= counter shows what it spends.
  reasoning: low
  # How long the cached rules and tool definitions live between questions on routes
  # that take an explicit cache breakpoint (Anthropic). 1h costs twice the input price
  # to write once an hour; 5m a quarter more than sending them, on every question more
  # than five minutes after the last. Other routes cache by themselves.
  cache_ttl: 1h
  # deny keeps prompts, which carry players' chat and names, off OpenRouter providers
  # that may train on them. DeepSeek's own endpoint is one of those; the other hosts of
  # the same models are not, so both defaults above stay available at the same prices.
  data_collection: deny

openrouter:
  api_key_env: OPENROUTER_API_KEY   # the key itself goes in .env, never here

anthropic:
  api_key_env: ANTHROPIC_API_KEY    # only read for provider: anthropic

# Per-question limits. A question that hits one still answers, with a notice saying why.
agent:
  max_rounds: 6                       # model turns per question
  max_tokens_per_question: 20000      # token budget across those turns; a cached input token counts a tenth
  max_output_tokens: 4096             # cap on one turn's output, thinking included
  max_tool_result_bytes: 4096         # a longer tool result is cut before the model sees it
  max_round_tool_result_bytes: 24000  # total tool-result bytes one round may add across every call; a call that would push past it is refused, not clipped, and the calls that already fit are kept
  # Sessions: the shared transcript follow-up questions see. One per chat scope
  # plus any "#name"; ends by idle time or on "new"; bounded by count and bytes,
  # dropping the oldest exchanges whole, so a session never adds more than about
  # two thousand tokens to a question.
  session_idle: 3m
  named_session_idle: 30m
  clarify_idle: 10m                   # widens the idle window while a session awaits the player's reply to an ask-back, so a clarifying question survives the walk to go look
  personality: off                    # off, or factorio for a light engineer-on-the-floor voice on the summary line. The text is fixed and owned by the service, not written here: flavour never changes a number, a unit, an item name or a table cell
  session_max_exchanges: 10
  session_max_bytes: 8000
  questions_per_player_per_hour: 20   # rolling-hour quota, -1 for no quota
  questions_per_hour: 120             # the whole server's rolling-hour quota, -1 for none
  max_cost_per_day: 5.0               # USD in a rolling day, whoever asks; -1 for no cap
  max_tool_calls: 30                  # lookups one question may make; a round over it is refused, the question goes on

# The event history for this save. A relative path is resolved against this file, so
# moving the config moves the database with it.
history:
  path: history.sqlite

# The observability ledger: one JSONL line per question and per model round
# (docs/design/phase4-observability-spec.md), what aab stats reads. It holds player
# names and question text by design, so it defaults on with an off switch rather than
# the other way around. Never slows or fails a question: a write error is logged once
# and swallowed.
# ledger:
#   enabled: true
#   dir: .            # default: the directory holding this config file

# The per-question game-state snapshot that rides beside every question, before
# the model is asked anything (docs/design/phase4-spec.md section 3): who is
# online, what each force is researching, the last few chat lines. Answers a
# good share of questions with no tool call at all, at a cost of roughly
# 400-800 tokens on the ones it does ride with. On by default; an operator can
# turn it off for the pre-Phase-4 behaviour.
# briefing:
#   enabled: true

# The service's own HTTP surface: /healthz and /v1/status (connected, mod version,
# questions answered, tokens, cost, model, uptime). Leave addr empty to turn it off.
# /healthz is always open; /v1/status needs the bearer token when one is configured.
control_api:
  addr: 127.0.0.1:8090
  token_env: AAB_CONTROL_TOKEN
