# Local runtime config: contains secrets and machine-specific paths
/.env
/service/.env
/service/aab.yaml
/service/aab-local.yaml
/service/aab.sftp.yaml
/service/aab.*.yaml

# Built binaries
/service/aab
/wizard/aab-wizard

# Runtime state written by the service
/service/history.sqlite
/service/history.sqlite-*

# Git worktrees for feature branches
/.worktrees/

# Effective-config snapshot the service writes at startup (inspection only)
aab.effective.yaml

# tests/e2e/run.py's own scratch state: write-data dirs, logs, the generated
# mods dir/mod-list, the generated aab.e2e.yaml and history.sqlite
/tests/e2e/.run/
/tests/e2e/__pycache__/
